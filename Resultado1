import random

def buscar_min_max(arreglo, i, minimo, maximo):
    if i == len(arreglo):
        return minimo, maximo
    
    if i == len(arreglo):
        return minimo, maximo

    if arreglo[i] % 3 == 0:
        if arreglo[i] < minimo:
            minimo = arreglo[i]
        if arreglo[i] > maximo:
            maximo = arreglo[i]

    return buscar_min_max(arreglo, i + 1, minimo, maximo)

n = int(input("Ingrese el tamaño del arreglo: "))
arreglo = []

for i in range(n):
    num = random.randint(10, 9999)
    arreglo.append(num)

print("Arreglo generado:", arreglo)

encontrado = False
for num in arreglo:
    if num % 3 == 0:
        minimo = num
        maximo = num
        encontrado = True
        break

if encontrado:
    minimo, maximo = buscar_min_max(arreglo, 0, minimo, maximo)
    promedio = (minimo + maximo) / 2

    print("Mínimo múltiplo de 3:", minimo)
    print("Máximo múltiplo de 3:", maximo)
    print("Promedio:", promedio)
else:
    print("No hay múltiplos de 3 en el arreglo")